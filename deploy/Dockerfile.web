# syntax=docker/dockerfile:1
# Loadder production web image (D2): the Vite build served by Caddy, which also terminates TLS and
# routes /api to the server and the sites hostname to the public-site runtime. No Node, no Vite dev
# server in the final image.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY index.html vite.config.ts tsconfig.json tsconfig.app.json tsconfig.node.json tailwind.config.js postcss.config.js components.json ./
COPY src ./src
COPY public ./public
# The API origin is compiled into the bundle (src/lib/api.ts), so it is a required build argument.
ARG VITE_API_BASE_URL
RUN test -n "$VITE_API_BASE_URL" || (echo "VITE_API_BASE_URL build argument is required (https://<app host>)" >&2; exit 1)
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM caddy:2-alpine AS runtime
ARG CADDYFILE=deploy/Caddyfile
COPY --from=build /app/dist /srv
COPY ${CADDYFILE} /etc/caddy/Caddyfile
