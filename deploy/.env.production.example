# Copy to deploy/.env.production (untracked, chmod 600) and fill in. Placeholders only; never commit real values.
# Use with: docker compose --env-file deploy/.env.production -f deploy/compose.prod.yaml ...

# --- Hostnames and certificates (REQUIRED) ---------------------------------------------------------
# Two DNS names pointing at this server: the application and the published sites.
LOADDER_APP_HOST=app.example.com
LOADDER_SITES_HOST=sites.example.com
LOADDER_ACME_EMAIL=ops@example.com

# --- REQUIRED FOR BOOT ------------------------------------------------------------------------------
# Long random value (e.g. `openssl rand -hex 32`). Hashes OTPs and signs storage links. Changing it
# invalidates outstanding sign-in codes.
AUTH_HASH_SECRET=

# --- REQUIRED FOR SIGN-IN (operators, patients, doctors) -------------------------------------------
# Without a real SMS provider nobody can sign in: the simulator is refused in production.
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=

# --- Recommended ------------------------------------------------------------------------------------
# Separate signing secret for private storage links (defaults to AUTH_HASH_SECRET).
LOADDER_STORAGE_SIGNING_SECRET=
# Education student sign-in uses the public app-user flow.
BUSINESS_BUILDER_PUBLIC_APPS_ENABLED=true

# --- Resources --------------------------------------------------------------------------------------
LOADDER_SERVER_MEM=1g

# --- Optional features (leave empty if unused) ------------------------------------------------------
EMAIL_PROVIDER=simulator
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OPENAI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_TOKEN_ENCRYPTION_KEY=
LOADDER_PAYMENT_PROVIDER=
LOADDER_PLATFORM_ADMIN_GRANTS=

# --- Medical documents (OFF by default; see docs/DOCKER_D2.md before enabling) ----------------------
