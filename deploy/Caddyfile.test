# Test edge for docker/ acceptance runs only: plain HTTP on *.localhost, no certificates.
{
	auto_https off
	admin off
}

http://app.localhost {
	encode zstd gzip
	handle /api/* {
		reverse_proxy server:3001
	}
	handle {
		root * /srv
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

http://sites.localhost {
	reverse_proxy server:3002
}
