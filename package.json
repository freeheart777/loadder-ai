{
  "name": "power-ai-hero",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n FRONTEND,BACKEND -c auto \"npm run dev:frontend\" \"npm run dev:server\"",
    "dev:frontend": "vite",
    "dev:server": "node --watch server/index.mjs",
    "start:server": "node server/index.mjs",
    "test:server": "npm --prefix server test",
    "check:db-boundary": "node server/scripts/check-db-boundaries.mjs",
    "workspace:assign-legacy-owner": "node server/scripts/assign-legacy-owner.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:infra": "playwright test e2e/infrastructure/browser-smoke.spec.ts",
    "test:e2e:store": "playwright test e2e/store/store-studio-v16.spec.ts",
    "test:e2e:commerce": "playwright test e2e/commerce/cart-checkout-order.spec.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
