            <span className="text-sm text-violet-200">
              پلتفرم هوشمند رشد کسب‌وکار
            </span>
          </div>

          <h1
            data-hero
            className="mt-6 max-w-[760px] text-[58px] font-bold leading-[1.32] tracking-[-0.03em]"
          >
