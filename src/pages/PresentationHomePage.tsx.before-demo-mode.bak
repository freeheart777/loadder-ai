import { useRef } from "react";
import { Link } from "react-router-dom";

import {
  ArrowLeft,
  Brain,
  Sparkle,
  ChartLineUp,
  UsersThree,
  Megaphone,
  Lightning,
  Globe,
  InstagramLogo,
} from "@phosphor-icons/react";

import {
  gsap,
  useGSAP,
} from "../lib/animations/gsap";

export default function PresentationHomePage() {
  const scope = useRef<HTMLDivElement | null>(null);

  useGSAP(
    () => {
      gsap.from("[data-hero]", {
        opacity: 0,
        y: 28,
        duration: 0.9,
        stagger: 0.1,
        ease: "power3.out",
      });

      gsap.from("[data-module]", {
        opacity: 0,
        y: 20,
        scale: 0.96,
        duration: 0.8,
        stagger: 0.08,
        delay: 0.4,
        ease: "power3.out",
      });

      gsap.to("[data-orbit]", {
        rotate: 360,
        duration: 28,
        repeat: -1,
        ease: "none",
        transformOrigin: "50% 50%",
      });

      gsap.to("[data-core]", {
        scale: 1.05,
        duration: 2.2,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut",
      });
    },
    {
      scope,
    }
  );

  return (
    <main
      ref={scope}
      dir="rtl"
      className="relative min-h-screen overflow-hidden bg-[#04050a] text-white"
    >
      {/* BACKGROUND */}

      <div className="pointer-events-none absolute inset-0">
        <div className="absolute -left-[180px] -top-[180px] h-[520px] w-[520px] rounded-full bg-violet-600/[0.13] blur-[150px]" />

        <div className="absolute -bottom-[180px] right-[15%] h-[520px] w-[520px] rounded-full bg-cyan-500/[0.08] blur-[160px]" />

        <div className="absolute left-1/2 top-[45%] h-[640px] w-[640px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-fuchsia-500/[0.05] blur-[180px]" />
      </div>

      {/* NAV */}

      <header className="relative z-30 border-b border-white/[0.06] bg-black/20 backdrop-blur-2xl">
        <div className="mx-auto flex max-w-[1500px] items-center justify-between px-8 py-5">
          <div
            dir="ltr"
            className="flex items-center gap-3"
          >
            <div className="flex h-11 w-11 items-center justify-center rounded-2xl border border-violet-300/20 bg-violet-500/10 shadow-[0_0_35px_rgba(139,92,246,0.18)]">
              <Sparkle
                size={23}
                weight="fill"
                className="text-violet-300"
              />
            </div>

            <div>
              <div className="bg-gradient-to-r from-cyan-300 via-blue-400 to-fuchsia-400 bg-clip-text text-2xl font-bold text-transparent">
                Loadder AI
              </div>

              <div className="text-[11px] text-white/35">
                AI Business Growth Platform
              </div>
            </div>
          </div>

          <div className="flex items-center gap-3">
            <Link
              to="/dashboard"
              className="rounded-xl border border-white/[0.08] bg-white/[0.035] px-5 py-3 text-sm text-white/70 transition hover:bg-white/[0.07] hover:text-white"
            >
              ورود به داشبورد
            </Link>

            <Link
              to="/dashboard/business-brain"
              className="flex items-center gap-2 rounded-xl bg-gradient-to-l from-blue-500 via-violet-500 to-fuchsia-500 px-5 py-3 text-sm font-semibold shadow-[0_10px_35px_rgba(139,92,246,0.18)] transition hover:scale-[1.02]"
