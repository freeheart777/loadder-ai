function MiniStat({
  value,
  title,
}: {
  value: string;
  title: string;
}) {
  return (
    <div className="rounded-2xl border border-white/[0.07] bg-white/[0.025] p-4 backdrop-blur-xl">
      <div className="text-2xl font-bold">
        {value}
      </div>

      <div className="mt-1 text-sm text-white/40">
        {title}
      </div>
    </div>
  );
}

function OrbitDot({
  className,
}: {
  className: string;
}) {
  return (
    <div
      className={`absolute h-3 w-3 rounded-full bg-cyan-300 shadow-[0_0_20px_rgba(103,232,249,0.95)] ${className}`}
    />
  );
}

function ModuleCard({
  className,
  icon: Icon,
  title,
  subtitle,
}: {
  className: string;
  icon: React.ElementType;
  title: string;
  subtitle: string;
}) {
  return (
    <div
      data-module
      className={`absolute z-10 w-[180px] rounded-[22px] border border-white/[0.08] bg-white/[0.035] p-4 shadow-2xl backdrop-blur-2xl ${className}`}
    >
      <div className="flex h-10 w-10 items-center justify-center rounded-xl border border-white/[0.07] bg-black/20">
        <Icon
          size={20}
          weight="duotone"
          className="text-cyan-300"
        />
      </div>

      <div className="mt-3 text-sm font-semibold">
        {title}
      </div>

      <div className="mt-1 text-xs text-white/35">
        {subtitle}
      </div>
    </div>
  );
}

function Feature({
  icon: Icon,
  title,
  text,
}: {
  icon: React.ElementType;
  title: string;
  text: string;
}) {
  return (
    <div className="flex items-center gap-4 rounded-[22px] border border-white/[0.06] bg-black/15 p-5">
      <div className="flex h-11 w-11 items-center justify-center rounded-xl bg-violet-500/10">
        <Icon
          size={21}
          weight="duotone"
          className="text-violet-300"
        />
      </div>

      <div>
        <div className="text-sm font-semibold">
          {title}
        </div>

        <div className="mt-1 text-sm text-white/35">
          {text}
        </div>
      </div>
    </div>
  );
}
