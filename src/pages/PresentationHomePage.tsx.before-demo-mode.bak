      {/* HERO */}

      <section className="relative z-10 mx-auto grid min-h-[calc(100vh-82px)] max-w-[1500px] items-center gap-16 px-8 py-16 xl:grid-cols-[1fr_620px]">
        <div>
          <div
            data-hero
            className="inline-flex items-center gap-2 rounded-full border border-violet-400/20 bg-violet-500/[0.08] px-4 py-2"
