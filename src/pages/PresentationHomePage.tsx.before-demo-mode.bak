            </span>
          </h1>

          <p
            data-hero
            className="mt-6 max-w-[720px] text-lg leading-9 text-white/55"
          >
            برند، محتوا، شبکه‌های اجتماعی، تبلیغات، CRM، تحلیل،
            KPI و اتوماسیون در Loadder به یک Business Brain مشترک
            متصل می‌شوند تا داده به تصمیم و تصمیم به رشد تبدیل شود.
          </p>

          <div
            data-hero
            className="mt-8 flex flex-wrap gap-3"
          >
            <Link
              to="/dashboard"
              className="flex items-center gap-3 rounded-2xl bg-gradient-to-l from-blue-500 via-violet-500 to-fuchsia-500 px-7 py-4 text-base font-semibold shadow-[0_14px_45px_rgba(139,92,246,0.22)] transition hover:scale-[1.025]"
            >
              ورود به پلتفرم

              <ArrowLeft
                size={18}
                weight="bold"
              />
            </Link>

            <Link
              to="/dashboard/business-brain"
              className="flex items-center gap-3 rounded-2xl border border-white/[0.10] bg-white/[0.035] px-7 py-4 text-base text-white/75 backdrop-blur-xl transition hover:bg-white/[0.07] hover:text-white"
            >
              <Brain
                size={19}
                weight="duotone"
                className="text-violet-300"
              />

              مشاهده Business Brain
            </Link>
          </div>

          <div
            data-hero
            className="mt-10 grid max-w-[670px] grid-cols-3 gap-3"
          >
            <MiniStat
              value="۹+"
              title="متخصص هوشمند"
            />

            <MiniStat
              value="۱"
              title="مغز مشترک"
            />

            <MiniStat
              value="360°"
              title="دید کسب‌وکار"
            />
          </div>
        </div>

        {/* VISUAL */}

        <div
          data-hero
          className="relative mx-auto h-[620px] w-full max-w-[620px]"
        >
          <div className="absolute left-1/2 top-1/2 h-[460px] w-[460px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-violet-300/[0.08]" />

          <div className="absolute left-1/2 top-1/2 h-[340px] w-[340px] -translate-x-1/2 -translate-y-1/2 rounded-full border border-cyan-300/[0.06]" />

          <div
            data-orbit
            className="absolute inset-0"
          >
            <OrbitDot className="left-[49%] top-[9%]" />
            <OrbitDot className="right-[9%] top-[48%]" />
            <OrbitDot className="bottom-[9%] left-[49%]" />
            <OrbitDot className="left-[9%] top-[48%]" />
          </div>

          <div className="absolute left-1/2 top-1/2 z-20 -translate-x-1/2 -translate-y-1/2">
            <div
              data-core
              className="relative flex h-[240px] w-[240px] items-center justify-center rounded-[64px] border border-violet-300/25 bg-gradient-to-br from-violet-500/20 via-[#11131c] to-cyan-500/10 shadow-[0_0_100px_rgba(124,58,237,0.28)] backdrop-blur-2xl"
            >
              <div className="absolute inset-4 rounded-[50px] border border-white/[0.05]" />

              <div className="relative z-10 text-center">
                <Brain
                  size={56}
                  weight="duotone"
                  className="mx-auto text-violet-300"
                />

                <div
                  dir="ltr"
                  className="mt-4 text-xl font-bold"
                >
                  Loadder Brain
                </div>

                <div className="mt-2 text-sm text-white/40">
                  مغز هوشمند کسب‌وکار
                </div>
              </div>
            </div>
          </div>

          <ModuleCard
            className="left-[2%] top-[8%]"
            icon={UsersThree}
            title="CRM"
            subtitle="مدیریت مشتریان"
          />

          <ModuleCard
            className="right-[2%] top-[8%]"
            icon={Megaphone}
            title="تبلیغات"
            subtitle="مدیریت کمپین"
          />

          <ModuleCard
            className="left-0 top-[43%]"
            icon={InstagramLogo}
            title="شبکه اجتماعی"
            subtitle="تعامل و لید"
          />

          <ModuleCard
            className="right-0 top-[43%]"
            icon={Sparkle}
            title="محتوا"
            subtitle="تولید هوشمند"
          />

          <ModuleCard
            className="bottom-[5%] left-[5%]"
            icon={ChartLineUp}
            title="تحلیل"
            subtitle="داده و Insight"
          />

          <ModuleCard
            className="bottom-[5%] right-[5%]"
            icon={Lightning}
            title="اتوماسیون"
            subtitle="اقدام هوشمند"
          />
        </div>
      </section>

      {/* BOTTOM STRIP */}

      <section className="relative z-10 border-t border-white/[0.05] bg-white/[0.015]">
        <div className="mx-auto grid max-w-[1500px] gap-3 px-8 py-8 md:grid-cols-4">
          <Feature
            icon={Globe}
            title="وب‌سایت"
            text="ساخت و تحلیل"
          />

          <Feature
            icon={Megaphone}
            title="تبلیغات"
            text="چندکاناله"
          />

          <Feature
            icon={UsersThree}
            title="CRM"
            text="داده مشتری"
          />

          <Feature
            icon={Brain}
            title="Business Brain"
            text="تصمیم هوشمند"
          />
        </div>
      </section>
