      <div className="text-2xl font-bold">
        {value}
      </div>

      <div className="mt-1 text-sm text-white/40">
        {label}
      </div>
    </div>
  );
}

function FloatingModule({
  className,
  icon: Icon,
  title,
}: {
  className: string;
  icon: React.ElementType;
  title: string;
}) {
  return (
    <div
      className={`absolute z-10 w-[165px] rounded-[22px] border border-white/[0.08] bg-white/[0.035] p-4 shadow-2xl backdrop-blur-2xl ${className}`}
    >
      <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-violet-500/10">
        <Icon
          size={20}
          weight="duotone"
          className="text-cyan-300"
        />
      </div>

      <div className="mt-3 text-sm font-semibold">
        {title}
      </div>
    </div>
  );
}

function OrbitDot({
  className,
}: {
  className: string;
}) {
  return (
    <div
      className={`absolute h-3 w-3 rounded-full bg-cyan-300 shadow-[0_0_20px_rgba(103,232,249,0.95)] ${className}`}
    />
  );
}

function BrainPoint({
  icon: Icon,
  title,
}: {
  icon: React.ElementType;
  title: string;
}) {
  return (
    <div className="flex items-center gap-3 rounded-2xl border border-white/[0.07] bg-white/[0.025] p-4">
      <CheckCircle
        size={19}
        weight="duotone"
        className="text-emerald-300"
      />

      <Icon
        size={19}
        weight="duotone"
        className="text-violet-300"
      />

      <span className="text-sm">
        {title}
      </span>
    </div>
  );
}

function DemoInsight({
  title,
  text,
}: {
  title: string;
  text: string;
}) {
  return (
    <div className="rounded-2xl border border-white/[0.07] bg-black/20 p-4">
      <div className="text-sm font-semibold text-violet-200">
        {title}
      </div>

      <p className="mt-2 text-sm leading-7 text-white/50">
        {text}
      </p>
    </div>
  );
}
