export default function PresentationHomePage() {
  const scope = useRef<HTMLDivElement | null>(null);

  useGSAP(
    () => {
      gsap.from("[data-hero]", {
        opacity: 0,
        y: 32,
        duration: 0.9,
        stagger: 0.1,
        ease: "power3.out",
      });

      gsap.from("[data-hero-card]", {
        opacity: 0,
        scale: 0.92,
        y: 20,
        duration: 1,
        delay: 0.35,
        ease: "power3.out",
      });

      gsap.to("[data-core]", {
        scale: 1.045,
        duration: 2.4,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut",
      });

      gsap.to("[data-orbit]", {
        rotate: 360,
        duration: 30,
        repeat: -1,
        ease: "none",
        transformOrigin: "50% 50%",
      });

      const sections =
        gsap.utils.toArray<HTMLElement>(
          "[data-section]"
        );

      sections.forEach((section) => {
        gsap.from(
          section.querySelectorAll(
            "[data-reveal]"
          ),
          {
            opacity: 0,
            y: 35,
            duration: 0.8,
            stagger: 0.08,
            ease: "power3.out",
            scrollTrigger: {
              trigger: section,
              start: "top 82%",
              once: true,
            },
          }
        );
      });

      ScrollTrigger.refresh();
    },
    {
      scope,
    }
  );

  return (
    <div
      ref={scope}
      dir="rtl"
      className="min-h-screen bg-[#04050a] text-white"
    >
