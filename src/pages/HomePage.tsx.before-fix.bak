import { useRef } from "react";
import { Link } from "react-router-dom";

import {
  ArrowLeft,
  Sparkle,
  Globe,
  InstagramLogo,
  Megaphone,
  UsersThree,
  ChartLineUp,
  Lightning,
  Article,
  Brain,
} from "@phosphor-icons/react";

import {
  gsap,
  useGSAP,
} from "../lib/animations/gsap";

const features = [
  {
    title: "سایت‌ساز هوشمند",
    icon: Globe,
  },
  {
    title: "تولید محتوا",
    icon: Article,
  },
  {
    title: "مدیریت شبکه‌های اجتماعی",
    icon: InstagramLogo,
  },
  {
    title: "تبلیغات هوشمند",
    icon: Megaphone,
  },
  {
    title: "CRM",
    icon: UsersThree,
  },
  {
    title: "تحلیل و گزارش",
    icon: ChartLineUp,
  },
  {
    title: "اتوماسیون",
    icon: Lightning,
  },
  {
    title: "Business Brain",
    icon: Brain,
  },
];

export default function HomePage() {
  const rootRef =
    useRef<HTMLDivElement | null>(null);

  const heroVisualRef =
    useRef<HTMLDivElement | null>(null);

  const tickerRef =
    useRef<HTMLDivElement | null>(null);

  useGSAP(
    () => {
      /*
      ==============================================
      HERO ENTRANCE
      ==============================================
      */

      const timeline = gsap.timeline({
        defaults: {
          ease: "power3.out",
        },
      });

      timeline
        .from("[data-logo]", {
          opacity: 0,
          x: -45,
          duration: 1,
        })
        .from(
          "[data-top-action]",
          {
            opacity: 0,
            y: -22,
            stagger: 0.12,
            duration: 0.65,
          },
          "-=0.65"
        )
        .from(
          "[data-eyebrow]",
          {
            opacity: 0,
            y: 20,
            duration: 0.6,
          },
          "-=0.25"
        )
        .from(
          "[data-title-line]",
          {
            opacity: 0,
            y: 55,
            filter: "blur(10px)",
            stagger: 0.14,
            duration: 0.85,
          },
          "-=0.35"
        )
        .from(
          "[data-description]",
          {
            opacity: 0,
            y: 22,
            duration: 0.7,
          },
          "-=0.4"
        )
        .from(
          "[data-hero-visual]",
          {
            opacity: 0,
            x: 75,
            scale: 0.96,
            duration: 1.2,
          },
          "-=1"
        )
        .from(
          "[data-ticker]",
          {
            opacity: 0,
            y: 35,
            duration: 0.8,
          },
          "-=0.5"
        );

      /*
      ==============================================
      HERO IMAGE FLOAT
      ==============================================
      */

      gsap.to("[data-hero-image]", {
        y: -10,
        duration: 3.5,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut",
      });

      /*
      ==============================================
      GLOW MOTION
      ==============================================
      */

      gsap.to("[data-glow-one]", {
        x: 55,
        y: -30,
        scale: 1.1,
        duration: 7,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut",
      });

      gsap.to("[data-glow-two]", {
        x: -45,
        y: 25,
        scale: 1.16,
        duration: 8,
        repeat: -1,
        yoyo: true,
        ease: "sine.inOut",
      });

      /*
      ==============================================
      FEATURE TICKER
      ==============================================
      */

      const ticker = tickerRef.current;

      if (ticker) {
        const tickerWidth =
          ticker.scrollWidth / 2;

        gsap.to(ticker, {
          x: -tickerWidth,
          duration: 28,
          repeat: -1,
          ease: "none",
        });
      }

      /*
      ==============================================
      DESKTOP MOUSE PARALLAX
      ==============================================
      */

      const root = rootRef.current;
      const visual =
        heroVisualRef.current;

      if (!root || !visual) return;

      const handleMouseMove = (
        event: MouseEvent
      ) => {
        if (window.innerWidth < 1024) {
          return;
        }

        const x =
          event.clientX / window.innerWidth -
          0.5;

        const y =
          event.clientY / window.innerHeight -
          0.5;

        gsap.to(visual, {
          x: x * 18,
          y: y * 12,
          rotateY: x * 1.5,
          rotateX: -y * 1.2,
          duration: 1.2,
          ease: "power3.out",
        });

        gsap.to("[data-grid]", {
          x: x * -15,
          y: y * -8,
          duration: 1.5,
          ease: "power3.out",
        });
      };

      window.addEventListener(
        "mousemove",
        handleMouseMove
      );

      return () => {
        window.removeEventListener(
          "mousemove",
          handleMouseMove
        );
      };
    },
    {
      scope: rootRef,
    }
  );

  return (
    <main
      ref={rootRef}
      dir="rtl"
      className="
        relative
        min-h-screen
        overflow-hidden
        bg-[#03040b]
        text-white
      "
    >
      {/* ===========================================
          BACKGROUND
      ============================================ */}

      <div className="absolute inset-0">
        <div className="absolute inset-0 bg-[radial-gradient(circle_at_72%_38%,rgba(66,46,190,0.22),transparent_34%),radial-gradient(circle_at_18%_68%,rgba(145,40,255,0.16),transparent_34%),linear-gradient(120deg,#02030a_0%,#050616_48%,#060519_100%)]" />

        <div
          data-grid
          className="
            absolute
            inset-0
            opacity-[0.13]
            [background-image:linear-gradient(rgba(255,255,255,.035)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.035)_1px,transparent_1px)]
            [background-size:70px_70px]
            [mask-image:linear-gradient(to_bottom,transparent,black_30%,black_70%,transparent)]
          "
        />

        <div
          data-glow-one
          className="
            pointer-events-none
            absolute
            -right-[8%]
            top-[18%]
            h-[500px]
            w-[500px]
            rounded-full
            bg-violet-600/[0.13]
            blur-[140px]
          "
        />

        <div
          data-glow-two
          className="
            pointer-events-none
            absolute
            -left-[8%]
            bottom-[10%]
            h-[420px]
            w-[420px]
            rounded-full
            bg-cyan-500/[0.08]
            blur-[150px]
          "
        />
      </div>

      {/* ===========================================
          HEADER
      ============================================ */}

      <header
        className="
          relative
          z-30
          mx-auto
          flex
          w-full
          max-w-[1600px]
          items-start
          justify-between
          px-7
          pt-7
          lg:px-12
          xl:px-16
        "
        dir="ltr"
      >
        {/* LOGO — LEFT */}

        <div
          data-logo
          className="
            flex
            items-center
            justify-start
          "
        >
          <img
            src="/loadder-logo.png"
            alt="Loadder"
            className="
              h-auto
              w-[185px]
              object-contain
              lg:w-[225px]
              xl:w-[255px]
            "
          />
        </div>

        {/* ACTIONS — RIGHT */}

        <div
          dir="rtl"
          className="
            hidden
            items-center
            gap-3
            md:flex
          "
        >
          <Link
            data-top-action
            to="/dashboard"
            className="
              group
              flex
              items-center
              gap-3
              rounded-[18px]
              bg-white
              px-6
              py-3.5
              text-[15px]
              font-semibold
              text-black
              shadow-[0_12px_45px_rgba(255,255,255,.10)]
              transition
              hover:scale-[1.025]
            "
          >
            ورود به پلتفرم

            <ArrowLeft
              size={18}
              weight="bold"
              className="
                transition
                group-hover:-translate-x-1
              "
            />
          </Link>

          <button
            data-top-action
            type="button"
            className="
              flex
              items-center
              gap-2.5
              rounded-[18px]
              border
              border-violet-400/30
              bg-violet-500/[0.07]
              px-6
              py-3.5
              text-[15px]
              text-white
              backdrop-blur-xl
              transition
              hover:border-cyan-300/35
              hover:bg-violet-500/[0.13]
            "
          >
            تجربه نسخه دمو

            <Sparkle
              size={17}
              weight="fill"
              className="text-cyan-300"
            />
          </button>
        </div>
      </header>

      {/* ===========================================
          HERO
      ============================================ */}

      <section
        className="
          relative
          z-20
          mx-auto
          grid
          min-h-[calc(100vh-100px)]
          max-w-[1600px]
          items-center
          gap-8
          px-7
          pb-[145px]
          pt-10
          lg:grid-cols-[0.87fr_1.13fr]
          lg:px-12
          lg:pt-4
          xl:px-16
        "
      >
        {/* HERO COPY */}

        <div
          className="
            relative
            z-20
            order-2
            max-w-[650px]
            lg:order-1
          "
        >
          <div
            data-eyebrow
            className="
              inline-flex
              items-center
              gap-2
              rounded-full
              border
              border-violet-400/25
              bg-violet-500/[0.06]
              px-4
              py-2.5
              backdrop-blur-xl
            "
          >
            <Sparkle
              size={16}
              weight="fill"
              className="text-violet-300"
            />

            <span className="text-[14px] text-white/75">
              آینده کسب‌وکارت را با هوش مصنوعی بساز
            </span>
          </div>

          <div className="mt-7 overflow-hidden">
            <h1
              data-title-line
              className="
                hero-headline
                text-[46px]
                font-bold
                leading-[1.38]
                tracking-[-0.04em]
                text-white
                lg:text-[58px]
                xl:text-[66px]
              "
            >
              یک پلتفرم.
            </h1>
          </div>

          <div className="overflow-hidden">
            <h2
              data-title-line
              className="
                hero-headline
                bg-gradient-to-l
                from-cyan-300
                via-blue-400
                to-fuchsia-400
                bg-clip-text
                text-[46px]
                font-bold
                leading-[1.38]
                tracking-[-0.045em]
                text-transparent
                lg:text-[58px]
                xl:text-[66px]
              "
            >
              تمام ابزارهای رشد.
            </h2>
          </div>

          <p
            data-description
            className="
              mt-7
              max-w-[580px]
              text-[16px]
              leading-[2.15]
              text-white/58
              lg:text-[17px]
            "
          >
            Loadder ساخت برند، تولید محتوا،
            شبکه‌های اجتماعی، تبلیغات، CRM،
            تحلیل داده و اتوماسیون را در یک
            پلتفرم هوشمند کنار هم قرار می‌دهد.
          </p>

          <div
            data-description
            className="
              mt-7
              flex
              flex-wrap
              gap-2.5
            "
          >
            <MiniTag title="Business Brain" />

            <MiniTag title="AI Native" />

            <MiniTag title="Growth Intelligence" />
          </div>

          {/* MOBILE ACTIONS */}

          <div
            className="
              mt-8
              flex
              flex-wrap
              gap-3
              md:hidden
            "
          >
            <Link
              to="/dashboard"
              className="
                flex
                items-center
                gap-3
                rounded-2xl
                bg-white
                px-5
                py-3.5
                text-sm
                font-semibold
                text-black
              "
            >
              ورود به پلتفرم

              <ArrowLeft
                size={17}
                weight="bold"
              />
            </Link>

            <button
              type="button"
              className="
                flex
                items-center
                gap-2
                rounded-2xl
                border
                border-violet-400/25
                bg-violet-500/[0.08]
                px-5
                py-3.5
                text-sm
              "
            >
              تجربه نسخه دمو

              <Sparkle
                size={16}
                weight="fill"
              />
            </button>
          </div>
        </div>

        {/* HERO VISUAL */}

        <div
          ref={heroVisualRef}
          data-hero-visual
          className="
            relative
            order-1
            flex
            min-h-[380px]
            items-center
            justify-center
            lg:order-2
            lg:min-h-[620px]
            [perspective:1400px]
          "
        >
          <div
            className="
              pointer-events-none
              absolute
              left-1/2
              top-1/2
              h-[70%]
              w-[75%]
              -translate-x-1/2
              -translate-y-1/2
              rounded-full
              bg-violet-500/[0.10]
              blur-[100px]
            "
          />

          <img
            data-hero-image
            src="/loader-hero.webp"
            alt="Loadder AI Platform"
            className="
              relative
              z-10
              max-h-[660px]
              w-full
              max-w-[850px]
              object-contain
              object-center
              drop-shadow-[0_35px_60px_rgba(0,0,0,.5)]
            "
          />
        </div>
      </section>

      {/* ===========================================
          MOVING FEATURE TICKER
      ============================================ */}

      <section
        data-ticker
        className="
          absolute
          bottom-7
          left-1/2
          z-30
          w-[calc(100%-40px)]
          max-w-[1500px]
          -translate-x-1/2
          overflow-hidden
          rounded-[28px]
          border
          border-violet-400/20
          bg-[#070913]/78
          py-4
          shadow-[0_0_35px_rgba(84,54,255,.09)]
          backdrop-blur-2xl
        "
      >
        <div
          className="
            pointer-events-none
            absolute
            inset-y-0
            left-0
            z-10
            w-28
            bg-gradient-to-r
            from-[#070913]
            to-transparent
          "
        />

        <div
          className="
            pointer-events-none
            absolute
            inset-y-0
            right-0
            z-10
            w-28
            bg-gradient-to-l
            from-[#070913]
            to-transparent
          "
        />

        <div
          ref={tickerRef}
          dir="ltr"
          className="
            flex
            w-max
            items-center
            whitespace-nowrap
          "
        >
          {[...features, ...features].map(
            (feature, index) => {
              const Icon = feature.icon;

              return (
                <div
                  key={`${feature.title}-${index}`}
                  className="
                    flex
                    items-center
                    gap-3
                    px-7
                    text-[14px]
                    text-white/65
                  "
                >
                  <Icon
                    size={18}
                    weight="duotone"
                    className="text-cyan-300"
                  />

                  <span dir="rtl">
                    {feature.title}
                  </span>

                  <span
                    className="
                      mr-4
                      h-5
                      w-px
                      bg-white/10
                    "
                  />
                </div>
              );
            }
          )}
        </div>

        {/* LIGHT RUNNER */}

        <div
          className="
            absolute
            bottom-0
            left-0
            h-px
            w-full
            bg-gradient-to-r
            from-transparent
            via-cyan-400/60
            to-transparent
          "
        />
      </section>
    </main>
  );
}

function MiniTag({
  title,
}: {
  title: string;
}) {
  return (
    <div
      className="
        rounded-full
        border
        border-white/[0.08]
        bg-white/[0.035]
        px-3.5
        py-2
        text-[12px]
        text-white/45
        backdrop-blur-lg
      "
    >
      {title}
    </div>
  );
}