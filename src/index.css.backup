@import url("https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&display=swap");

@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  font-family:
    "Vazirmatn",
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  color: #ffffff;
  background: #030617;

  font-synthesis: none;
  text-rendering: optimizeLegibility;

  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html,
body,
#root {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: #030617;
}

body {
  color: #ffffff;
  font-family:
    "Vazirmatn",
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

/* Safe Loadder background */

.loadder-dashboard-bg {
  min-height: 100vh;
  width: 100%;

  background:
    radial-gradient(
      circle at 15% 20%,
      rgba(139, 92, 246, 0.16),
      transparent 34%
    ),
    radial-gradient(
      circle at 85% 30%,
      rgba(34, 211, 238, 0.12),
      transparent 34%
    ),
    linear-gradient(
      180deg,
      #030617 0%,
      #050816 50%,
      #02030b 100%
    );
}

/* Glass cards */

.liquid-glass {
  background: rgba(8, 13, 29, 0.7);

  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);

  border: 1px solid rgba(255, 255, 255, 0.08);

  box-shadow:
    inset 0 1px 1px rgba(255, 255, 255, 0.06),
    0 16px 40px rgba(0, 0, 0, 0.18);
}

::selection {
  background: rgba(139, 92, 246, 0.4);
  color: #ffffff;
}

::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: #030617;
}

::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.14);
  border-radius: 999px;
}